# No API keys required! LLM runs locally via Ollama.
# Install Ollama: https://ollama.com
# Pull model: ollama pull llama3.2:3b

# Optional: Instagram login (needed for full access; rate-limit to reduce ban risk)
# INSTAGRAM_USER=
# INSTAGRAM_PASSWORD=

# Optional: proxy for scrapers (e.g. http://user:pass@host:port)
# HTTP_PROXY=
# HTTPS_PROXY=

# Optional: cache window in hours (skip re-scrape if data younger than this)
# CACHE_HOURS=24

# Optional: delay in seconds between scraper requests (rate limiting)
# RATE_LIMIT_DELAY_SECONDS=1.5

# Required in production: bearer token guarding GET /api/interview/finalize.
# When unset (dev mode), the GET endpoint is open and the server logs a single
# warning. Set this to a strong random value before deploying.
# ADMIN_TOKEN=
